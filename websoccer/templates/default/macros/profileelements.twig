{% macro infofield(label, value, doNotEscape = false) %}

<div class="row inforow">
	<div class="col-md-6 infolabel">{% if doNotEscape %}{{ label|raw }}{% else %}{{ label }}{% endif %}</div>
	<div class="col-md-6 infovalue">{% if doNotEscape %}{{ value|raw }}{% else %}{{ value }}{% endif %}</div>
</div>
{% endmacro %}
