{% macro badge(label, level, date = null) %}
	{% if i18n.hasMessage(label) %}
		{% set label = i18n.getMessage(label) %}
	{% endif %}

	<a href="{{ env.getInternalUrl("badges") }}"><span class="badge wstooltip{% if level == 'bronze' %} ws-badge-bronze{% elseif level == 'silver' %} ws-badge-silver{% else %} ws-badge-gold{% endif %}" title="{{ i18n.getMessage("badge_level_" ~ level) }}{% if date != null %} ({{ env.getFormattedDate(date, i18n) }}){% endif %}">{{ label }}</span></a>
{% endmacro %}
