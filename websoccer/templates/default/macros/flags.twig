{# Flag rendering for countries and UI languages.

   The SVG files are generated by "npm run build:flags" (see
   scripts/copy-flags.js) into img/flags. Countries without a flag file fall
   back to the plain label, so nationalities that are not covered by the flag
   set still show up. #}

{# Flag of a nationality. "nationality" is the untranslated nationality value,
   which is also the flag file name (e.g. "Deutschland"). The label defaults to
   the translated country name and is rendered next to the flag when
   "withLabel" is set. #}
{% macro country(nationality, label = null, withLabel = false) %}
{%- if label is null -%}
	{%- set label = i18n.hasMessage('option_' ~ nationality) ? i18n.getMessage('option_' ~ nationality) : nationality -%}
{%- endif -%}
{{- _self.image('countries', nationality, label, withLabel) -}}
{% endmacro %}

{# Flag of a supported UI language, identified by its language code. #}
{% macro language(languageCode, label = null, withLabel = false) %}
{%- if label is null -%}
	{%- set label = i18n.getMessage('lang_label_' ~ languageCode) -%}
{%- endif -%}
{{- _self.image('languages', languageCode, label, withLabel) -}}
{% endmacro %}

{% macro image(folder, fileName, label, withLabel) %}
{%- set source = fileName|length > 0 ? skin.getImage('flags/' ~ folder ~ '/' ~ fileName ~ '.svg') : false -%}
{%- if source -%}
<img src="{{ source }}" class="ws-flag" alt="{{ label }}" title="{{ label }}">{% if withLabel %}<span class="ws-flag-label">{{ label }}</span>{% endif %}
{%- else -%}
{{- label -}}
{%- endif -%}
{% endmacro %}
