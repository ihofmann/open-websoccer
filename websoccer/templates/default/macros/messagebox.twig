{% macro box(title, message, type, testId = null) %}

{% if type is null or type|length == 0 %}
	{% set type = 'danger' %}
{% elseif type == 'error' %}
	{% set type = 'danger' %}
{% endif %}

<div class="alert alert-{{ type|default('danger') }}"{% if testId %} data-testid="{{ testId }}"{% endif %}>
  <strong>{{ title }}</strong>
  {{ message }}
</div>

{% endmacro %}
