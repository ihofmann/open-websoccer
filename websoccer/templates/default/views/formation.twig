{% extends "views/formation_base.twig" %}

{# Macro imports of the parent template are not visible inside the blocks
   defined here, so they have to be imported again. #}
{% import "macros/formelements.twig" as formelements %}

{% block formation_setup %}
	<form method="post" class="d-flex flex-wrap gap-2 align-items-center">
		<input type="hidden" name="page" value="formation" />
		<input type="hidden" name="templateid" value="" />
		<input type="hidden" name="nationalteam" value="{{ env.getRequestParameter("nationalteam") }}" />

		<select class="form-select select-form-submit" name="id">
			{% for nextMatch in nextMatches %}
				<option value="{{ nextMatch.match_id }}"{% if env.getRequestParameter("id") == nextMatch.match_id %} selected{% endif %}>({{ env.getFormattedDatetime(nextMatch.match_date) }}) {{ nextMatch.match_home_name }} - {{ nextMatch.match_guest_name }}</option>
			{% endfor %}
		</select>
	</form>

	<div class="row g-4">
		<div class="col-md-4">
			<p><em>{{ env.getFormattedDatetime(next_match.match_date) }} | {{ i18n.getMessage("matchtype_" ~ next_match.match_type) }}</em></p>
			<p><strong><a href="{{ env.getInternalUrl("team", "id=" ~ next_match.match_home_id) }}">{{ next_match.match_home_name }}</a> - <a href="{{ env.getInternalUrl("team", "id=" ~ next_match.match_guest_id) }}">{{ next_match.match_guest_name }}</a></strong></p>
		</div>
		<div class="col-md-3">
			<p><em>{{ i18n.getMessage("next_match_block_previous_matches") }}</em></p>
			{% if previous_matches is defined and previous_matches|length > 0 %}
			<table class="table">
			{% for previousMatch in previous_matches %}
				<tr>
					<td>{{ previousMatch.home_team }} - {{ previousMatch.guest_team }}</td>
					<td><a href="{{ env.getInternalUrl("match", "id=" ~ previousMatch.id) }}">{{ previousMatch.home_goals }} - {{ previousMatch.guest_goals }}</a></td>
				</tr>
			{% endfor %}
			</table>
			{% else %}
			<p>{{ i18n.getMessage("next_match_block_no_previous_matches") }}</p>
			{% endif %}
		</div>
	</div>

	<form method="post" class="d-flex flex-wrap gap-2 align-items-center mb-4">
		<input type="hidden" name="page" value="formation" />
		<input type="hidden" id="preselect" name="preselect" value="" />
		<input type="hidden" name="nationalteam" value="{{ env.getRequestParameter("nationalteam") }}" />
		<input type="hidden" name="id" value="{{ next_match.match_id }}" />

		<h4>{{ i18n.getMessage("formation_setup_title") }}</h4>

		<select class="form-select form-select-sm w-auto wstooltip" name="formation_defense" title="{{ i18n.getMessage("player_position_defense") }}">
			{% for i in 1..4 %}
				<option value="{{ i }}"{% if setup.defense == i %} selected{% endif %}>{{ i }}</option>
			{% endfor %}
		</select>
		<span>-</span>
		<select class="form-select form-select-sm w-auto wstooltip" name="formation_defensemidfield" title="{{ i18n.getMessage("option_DM") }}">
			{% for i in 0..3 %}
				<option value="{{ i }}"{% if setup.dm == i %} selected{% endif %}>{{ i }}</option>
			{% endfor %}
		</select>
		<span>-</span>
		<select class="form-select form-select-sm w-auto wstooltip" name="formation_midfield" title="{{ i18n.getMessage("player_position_midfield") }}">
			{% for i in 0..4 %}
				<option value="{{ i }}"{% if setup.midfield == i %} selected{% endif %}>{{ i }}</option>
			{% endfor %}
		</select>
		<span>-</span>
		<select class="form-select form-select-sm w-auto wstooltip" name="formation_offensivemidfield" title="{{ i18n.getMessage("option_OM") }}">
			{% for i in 0..3 %}
				<option value="{{ i }}"{% if setup.om == i %} selected{% endif %}>{{ i }}</option>
			{% endfor %}
		</select>
		<span>-</span>
		<select class="form-select form-select-sm w-auto wstooltip" name="formation_forward" title="{{ i18n.getMessage("option_MS") }}">
			{% for i in 0..2 %}
				<option value="{{ i }}"{% if setup.striker == i %} selected{% endif %}>{{ i }}</option>
			{% endfor %}
		</select>
		<span>-</span>
		<select class="form-select form-select-sm w-auto wstooltip" name="formation_outsideforward" title="{{ i18n.getMessage("player_position_outsideforward") }}">
			{% for i in [0,2] %}
				<option value="{{ i }}"{% if setup.outsideforward == i %} selected{% endif %}>{{ i }}</option>
			{% endfor %}
		</select>

		<div class="btn-group">
			<button type="submit" class="btn btn-secondary" name="buttonSetupChange" value="1">{{ i18n.getMessage("formation_setup_button") }}</button>

			{% if env.getConfig("hide_strength_attributes") != "1" %}
			<button class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" data-testid="preselect-dropdown-toggle" aria-expanded="false">
			</button>
			<ul class="dropdown-menu">
				<li><a href="#" class="dropdown-item formationSetupSubmit" data-preselect="strongest" data-testid="formation-setup-submit"><i class="bi bi-rocket"></i> {{ i18n.getMessage("formation_setup_strongest") }}</a></li>
				<li><a href="#" class="dropdown-item formationSetupSubmit" data-preselect="freshest" data-testid="formation-setup-submit"><i class="bi bi-heart-fill"></i> {{ i18n.getMessage("formation_setup_freshest") }}</a></li>
				<li><a href="#" class="dropdown-item formationSetupSubmit" data-preselect="motivated" data-testid="formation-setup-submit"><i class="bi bi-emoji-smile"></i> {{ i18n.getMessage("formation_setup_motivated") }}</a></li>
			</ul>
			{% endif %}
		</div>
		{% if env.getConfig("formation_max_templates") > 0  and not env.getRequestParameter("nationalteam") %}
		<a class="btn btn-secondary ajaxLink" href="#templatesModal" role="button" data-bs-toggle="modal"
			data-ajaxblock="formation_templates" data-ajaxtarget="formation-templates-content"
			data-ajaxquerystr="id={{ next_match.match_id }}"><i class="bi bi-folder2-open"></i> {{ i18n.getMessage("formation_load_from_template") }}</a>
		{% endif %}
		<a class="btn btn-secondary clearAllBtn" href="#" data-testid="clear-all"><i class="bi bi-trash"></i> {{ i18n.getMessage("formation_clearall") }}</a>
	</form>

	<div id="templatesModal" class="modal fade" tabindex="-1" role="dialog"
		aria-labelledby="templatesModalLabel" aria-hidden="true">
	  <div class="modal-dialog">
	    <div class="modal-content">
		  <div class="modal-header">
		    <h5 class="modal-title" id="templatesModalLabel">{{ i18n.getMessage("formation_load_from_template") }}</h5>
		    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		  </div>
		  <div class="modal-body">
			<div id="formation-templates-content">...</div>
		  </div>
		  <div class="modal-footer">
		    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{ i18n.getMessage("button_close") }}</button>
		  </div>
	    </div>
	  </div>
	</div>
{% endblock %}


{% block form_footer %}
<h4>{{ i18n.getMessage("formation_freekickplayer") }}</h4>

<select name="freekickplayer" id="freekickplayer" class="form-select w-auto" data-preselect="{{ formation.freekickplayer }}">
	<option value=""></option>
</select>

<h4>{{ i18n.getMessage("formation_offensive_title") }}</h4>

{{ formelements.slider("offensive", formation.offensive) }}

	<div class="row mt-2">
		<div class="mb-3">
			<label class="form-label" for="longpasses">{{ i18n.getMessage("formation_option_longpasses") }} <i class="bi bi-question-circle wstooltip" data-bs-toggle="tooltip" title="{{ i18n.getMessage('formation_option_longpasses_help') }}"></i></label>
			<div class="form-check form-switch">
				<input class="form-check-input" type="checkbox" role="switch" id="longpasses" name="longpasses" value="1"{% if formation.longpasses is defined and formation.longpasses %} checked{% endif %}>
				<label class="form-check-label" for="longpasses">{{ i18n.getMessage("formation_switch_on") }}</label>
			</div>
		</div>

		<div class="mb-3">
			<label class="form-label" for="counterattacks">{{ i18n.getMessage("formation_option_counterattacks") }} <i class="bi bi-question-circle wstooltip" data-bs-toggle="tooltip" title="{{ i18n.getMessage('formation_option_counterattacks_help') }}"></i></label>
			<div class="form-check form-switch">
				<input class="form-check-input" type="checkbox" role="switch" id="counterattacks" name="counterattacks" value="1"{% if formation.counterattacks is defined and formation.counterattacks %} checked{% endif %}>
				<label class="form-check-label" for="counterattacks">{{ i18n.getMessage("formation_switch_on") }}</label>
			</div>
		</div>
		{% if env.getConfig("formation_max_templates") > 0 and not env.getRequestParameter("nationalteam") %}
		<hr/>
		{{ formelements.textfield('templatename', i18n.getMessage('formation_templatename_field'), env.getRequestParameter('templatename'), false, validationMsg, 'text', i18n.getMessage('formation_templatename_field_help')) }}
		{% endif %}
	</div>

	<div class="d-flex gap-2 justify-content-center p-3 text-center">
		{% if next_match.match_id is defined %}
		<button type="submit" class="btn btn-primary">{{ i18n.getMessage('button_save') }}</button>
		{% else %}
		<a href="#disabledSave" id="disabledSave" class="btn btn-primary disabled">{{ i18n.getMessage('button_save') }}</a>
		{% endif %}

		<a href="{{ env.getInternalUrl(env.getPageId()) }}" class="btn btn-secondary">{{ i18n.getMessage('button_reset') }}</a>
	</div>
	<input type="hidden" name="setup" value="{{ setup.defense }}-{{ setup.dm }}-{{ setup.midfield }}-{{ setup.om }}-{{ setup.striker }}-{{ setup.outsideforward }}"/>
	<input type="hidden" name="page" value="formation"/>
	<input type="hidden" name="action" value="save-formation"/>
	<input type="hidden" name="id" value="{{ next_match.match_id }}"/>
	<input type="hidden" name="nationalteam" value="{{ env.getRequestParameter("nationalteam") }}" />

{% endblock %}
