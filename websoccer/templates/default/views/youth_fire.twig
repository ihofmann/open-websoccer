{% extends "base.twig" %}

{% block page_title %}
{{ i18n.getMessage("youthplayer-fire_navlabel") }}
{% endblock %}

{% block page_content %}
<form class="row" method="post" data-testid="youth-fire-form">

	<fieldset>
		<legend>{{ i18n.getMessage("youthplayer-fire_formlabel") }}</legend>
		
		<p><strong>{{ i18n.getMessage("youthplayer-fire_confirmationmsg") }}</strong></p>
	</fieldset>
	<div class="d-flex gap-2 justify-content-center p-3">
		<button type="submit" class="btn btn-primary" data-testid="youth-fire-confirm">{{ i18n.getMessage('button_confirm') }}</button>
		<a href="{{ env.getInternalUrl("youth-team") }}" class="btn btn-secondary" data-testid="youth-fire-cancel">{{ i18n.getMessage('button_cancel') }}</a>
	</div>
	<input type="hidden" name="page" value="youthplayer-fire"/>
	<input type="hidden" name="id" value="{{ env.getRequestParameter('id') }}"/>
	<input type="hidden" name="action" value="fire-youthplayer"/>
</form>
{% endblock %}