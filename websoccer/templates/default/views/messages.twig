{% import "macros/paginator.twig" as pagination %}
{% import "macros/profileelements.twig" as profile %}

{% extends "base.twig" %}

{% block page_title %}
{{ i18n.getMessage("messages_navlabel") }}
{% endblock %}

{% block page_content %}

{% if env.getConfig("messages_enabled") %}
	<p><a href="{{ env.getInternalUrl() }}" class="btn btn-sm"><i class="bi bi-arrow-clockwise"></i> {{ i18n.getMessage("button_refresh") }}</a>
	<a href="#composeMessage" class="btn btn-sm" data-bs-toggle="modal"><i class="bi bi-pencil"></i> {{ i18n.getMessage("messages_compose_button") }}</a></p>
	<form class="row">
		<div id="composeMessage" class="modal fade" tabindex="-1" role="dialog" 
			aria-labelledby="composeModalLabel" aria-hidden="true">
		  <div class="modal-dialog"><div class="modal-content">
		  <div class="modal-header">
		    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		    <h5 class="modal-title" id="composeModalLabel">{{ i18n.getMessage("messages_compose_title") }}</h5>
		  </div>
		  <div class="modal-body">
		  
			  <div id="modalmessages"></div>
			  <div id="sendmsgbody">
				{{ viewHandler.renderBlock("compose-message-body")|raw }}
		  	  </div>
		  </div>
		  <div class="modal-footer">
		  	<button type="submit" class="btn btn-primary ajaxSubmit" 
				data-ajaxtarget="sendmsgbody" data-ajaxblock="compose-message-body" data-messagetarget="modalmessages">{{ i18n.getMessage('messages_send_button') }}</button>
		    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ i18n.getMessage("button_close") }}</button>
		  </div>
		  </div></div>
		</div>
		
		<input type="hidden" name="action" value="send-message"/>
	</form>
{% endif %}

<ul class="nav nav-tabs" id="teamTab">
  <li class="nav-item"><a class="nav-link active" href="#inbox" data-bs-toggle="tab">{{ i18n.getMessage("messages_tab_inbox") }}</a></li>
  <li class="nav-item"><a class="nav-link ajaxLink" href="#outbox" data-bs-toggle="tab"
  	data-ajaxtarget="outboxlist" data-ajaxblock="messages-outbox">{{ i18n.getMessage("messages_tab_outbox") }}</a></li>
</ul>

<div class="tab-content">
  <div class="tab-pane active" id="inbox">
  
  	{% if messages|length > 0 %}
  	
  	<table class="table table-striped">
  		<thead>
  			<tr>
  				<th>{{ i18n.getMessage("messages_date") }}</th>
  				<th>{{ i18n.getMessage("messages_sender") }}</th>
  				<th>{{ i18n.getMessage("messages_subject") }}</th>
  				<th>&nbsp;</th>
  			</tr>
  		</thead>
  		<tbody>
  		{% for message in messages %}
  			<tr>
  				<td>{{ env.getFormattedDatetime(message.date) }}</td>
  				<td><a href="{{ env.getInternalUrl("user", "id=" ~ message.sender_id) }}">{{ message.sender_name }}</a></td>
  				<td>
  				{% if not message.seen %}<strong>{% endif %}
  				<a href="#showMessage" data-bs-toggle="modal" class="ajaxLink"
  					data-ajaxtarget="messagecontent" data-ajaxblock="message-details" data-ajaxquerystr="id={{ message.message_id }}">{{ message.subject }}</a>
  				{% if not message.seen %}</strong>{% endif %}
  				</td>
  				<td><a href="{{ env.getInternalUrl("messages", "action=delete-message&id=" ~ message.message_id) }}" title="{{ i18n.getMessage("messages_delete") }}"><i class="bi bi-trash"></i></a></td>
  			</tr>
  		{% endfor %}
  		</tbody>
  	</table>
  	
  	{{ pagination.paginator(paginator) }}
  	
  	{% else %}
  	<p>{{ i18n.getMessage("messages_empty_inbox") }}</p>
  	{% endif %}
  
  </div>
  <div class="tab-pane" id="outbox">
  	<div id="outboxlist"></div>
  </div>
</div>

	<div id="showMessage" class="modal fade" tabindex="-1" role="dialog" 
		aria-labelledby="messageModalLabel" aria-hidden="true">
	  <div class="modal-dialog"><div class="modal-content">
	  <div class="modal-header">
	    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	    <h5 class="modal-title" id="messageModalLabel">{{ i18n.getMessage("messages_details_title") }}</h5>
	  </div>
	  <div class="modal-body">
	    <div id="messagecontent"></div>
	  </div>
	  <div class="modal-footer">
	    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ i18n.getMessage("button_close") }}</button>
	  </div>
	  </div></div>
	</div>
{% endblock %}