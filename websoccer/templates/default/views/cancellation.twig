{% extends "base.twig" %}

{% block page_title %}
{{ i18n.getMessage("cancellation_title") }}
{% endblock %}

{% block page_content %}
<p>{{ i18n.getMessage("cancellation_intro") }}</p>

<p><a href="#cancelModal" role="button" data-bs-toggle="modal" class="btn btn-primary">{{ i18n.getMessage("cancellation_button") }}</a></p>

<div id="cancelModal" class="modal fade" tabindex="-1" role="dialog" 
	aria-labelledby="cancelModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="cancelModalLabel">{{ i18n.getMessage("cancellation_modal_title") }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
      	<p>{{ i18n.getMessage("cancellation_modal_content") }}</p>
      </div>
      <div class="modal-footer">
      	<a href="{{ env.getInternalActionUrl("disable-account") }}" class="btn btn-primary">{{ i18n.getMessage("cancellation_modal_confirm") }}</a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ i18n.getMessage("button_cancel") }}</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}