{% extends "base.twig" %}
{% import "macros/formelements.twig" as formelements %}

{% block page_title %}
{{ i18n.getMessage("youthplayer-sell_navlabel") }}
{% endblock %}

{% block page_content %}
<form class="row" method="post" data-testid="youth-sell-form">

	<fieldset>
		<legend>{{ i18n.getMessage("youthplayer-sell_formlabel") }}</legend>
		{{ formelements.textfield('transfer_fee', i18n.getMessage('entity_youthplayer_transfer_fee'), env.getRequestParameter('transfer_fee'), true, validationMsg, 'number', null, false, 'youth-sell-transfer-fee') }}
	</fieldset>
	<div class="d-flex gap-2 justify-content-center p-3">
		<button type="submit" class="btn btn-primary" data-testid="youth-sell-submit">{{ i18n.getMessage('button_submit') }}</button>
		<a href="{{ env.getInternalUrl("youth-team") }}" class="btn btn-secondary" data-testid="youth-sell-cancel">{{ i18n.getMessage('button_cancel') }}</a>
	</div>
	<input type="hidden" name="page" value="youthplayer-sell"/>
	<input type="hidden" name="id" value="{{ env.getRequestParameter('id') }}"/>
	<input type="hidden" name="action" value="sell-youthplayer"/>
</form>
{% endblock %}