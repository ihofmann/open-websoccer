{% extends "base.twig" %}

{% block page_title %}
{{ i18n.getMessage("tablehistory_title", teamName) }}
{% endblock %}

{% block page_content %}

	<p><a href="{{ env.getInternalUrl("league", "id=" ~ leagueid) }}" class="btn btn-outline-primary"><i class="bi bi-table"></i> {{ i18n.getMessage("league_navlabel") }}</a></p>
	

	{% if history|length > 0 %}
	
		<div class="fw-bold">{{ i18n.getMessage("leaguetable_head_place") }}</div>
		<div class="position-relative">
			<div id="leaguehistorychart" class="ws-chart-history"
					data-maxpos="{{ noOfTeamsInLeague }}"
	  				data-series="[{% for record in history %}{% if loop.index > 1 %}, {% endif %}[{{ record.matchday }}, {{ record.rank }}]{% endfor %}]"></div>
			<div class="ws-chart-history-label">{{ i18n.getMessage("entity_match_spieltag") }}</div>
		</div>
	{% endif %}
	
{% endblock %}