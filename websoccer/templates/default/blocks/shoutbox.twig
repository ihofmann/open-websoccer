{% extends "box.twig" %}

{% block box_title %}
{{ i18n.getMessage('shoutbox_title') }}
{% endblock %}

{% block box_content %}
<div id="shoutboxvalmessages"></div>

<div class="text-end">
	<a href="#shrefresh" id="shrefresh" class="btn btn-sm btn-outline-primary ajaxLink mb-1"
		data-ajaxtarget="shoutbox_block" data-ajaxblock="shoutbox" data-ajaxquerystr="id={{ env.getRequestParameter("id") }}"
		><i class="bi bi-arrow-clockwise"></i> {{ i18n.getMessage("button_refresh") }}</a>
</div>
<div class="shoutboxmessages">

	{% for message in messages %}
	<div>
		{% if env.user.isAdmin() %}<a href="#" class="ajaxLink" 
		data-ajaxtarget="shoutbox_block" data-ajaxblock="shoutbox" data-ajaxquerystr="id={{ env.getRequestParameter("id") }}&action=delete-shoutbox-message&mid={{ message.message_id }}" title="{{ i18n.getMessage("button_delete") }}"><i class="bi bi-trash"></i></a>{% endif %} <small class="text-muted ws-fs-9">[{{ env.getFormattedDatetime(message.date, i18n) }}] <a href="{{ env.getInternalUrl("match", "id=" ~ message.match_id) }}" class="text-muted">{{ message.home_name }} - {{ message.guest_name }}</a></small>
		<br>
		<a href="{{ env.getInternalUrl("user", "id=" ~ message.user_id) }}">{{ message.user_name }}</a>: {{ message.message }}
	</div>
	{% endfor %}

</div>
{% if env.user.id and (hidesubmit is not defined or not hidesubmit) %}
<form class="form d-flex flex-wrap gap-2 align-items-center" method="post">
	<input type="hidden" name="action" value="send-shoutbox-msg"/>
	<input type="hidden" name="block" value="shoutbox"/>
	<input type="hidden" name="id" value="{{ env.getRequestParameter("id") }}"/>
	
	<input class="form-control col-md-3" id="msgtext" name="msgtext" type="text" placeholder="{{ i18n.getMessage("shoutbox_messageinput_placeholder") }}" required="true" 
		value="{% if validationMsg["msgtext"] is defined %}{{ env.getRequestParameter("msgtext") }}{% endif %}">
	<input type="submit" class="btn btn-outline-primary ajaxSubmit"
		data-ajaxtarget="shoutbox_block" data-messagetarget="shoutboxvalmessages" value="{{ i18n.getMessage("shoutbox_button_go") }}"/>
		
	{% if validationMsg["msgtext"] is defined %}<p class="text-danger">{{ validationMsg["msgtext"] }}</p>{% endif %}
</form>
{% else %}
	<p><small>{{ i18n.getMessage('shoutbox_hiddensubmit_note') }}</small></p>
{% endif %}

{% endblock %}