<p><a href="#offerModal" role="button" data-bs-toggle="modal" class="btn btn-sm btn-outline-primary ajaxLink"
	data-ajaxtarget="offerFormBlock" data-ajaxblock="directtransfer-offer-form" data-ajaxquerystr="id={{ env.getRequestParameter("id") }}&loadformdata=1"><i class="bi bi-cart"></i> {{ i18n.getMessage("transferoffer_button") }}</a></p>

<form method="post" class="row">
	<div id="offerModal" class="modal fade" tabindex="-1" role="dialog"
		aria-labelledby="offerModalLabel" aria-hidden="true">
	  <div class="modal-dialog"><div class="modal-content">
	  <div class="modal-header">
	    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	    <h5 class="modal-title" id="offerModalLabel">{{ i18n.getMessage("transferoffer_modal_title") }}</h5>
	  </div>
	  <div class="modal-body">
	  	<div id="modalMessages"></div>
	  	<div id="offerFormBlock">...</div>
	  </div>
	  <div class="modal-footer">
	  	<button id="offerSubmit" type="submit" class="btn btn-primary ajaxSubmit"
			data-ajaxtarget="offerFormBlock" data-ajaxblock="directtransfer-offer-form"
			data-messagetarget="modalMessages">{{ i18n.getMessage("button_submit") }}</button>
	    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ i18n.getMessage("button_close") }}</button>
	  </div>
	  </div></div>
	</div>

	<input type="hidden" name="page" value="player">
	<input type="hidden" name="id" value="{{ env.getRequestParameter("id") }}">
	<input type="hidden" name="action" value="directtransfer-offer">
	<input type="hidden" name="loadformdata" value="1">
</form>
