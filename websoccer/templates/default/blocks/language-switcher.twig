{% extends "box.twig" %}

{% import "macros/flags.twig" as flags %}

{% block box_title %}
{{ i18n.getMessage('langswitcher_block_title') }}
{% endblock %}

{% block box_content %}

<ul class="languageswitcher">
{% for language in i18n.supportedLanguages %}
	<li><a href="{{ env.getInternalActionUrl("switch-language", "lang=" ~ language ~ "&id=" ~ env.getRequestParameter("id")) }}">{{ flags.language(language) }}</a></li>
{% endfor %}
</ul>

{% endblock %}