
{% extends "blocks/table_base.twig" %}

{% block table_header %}
	{% if seasons|length > 0 %}
		<ul class="nav nav-pills mb-3" role="tablist">
			<li class="nav-item" role="presentation">
				<a href="#currentTable" class="nav-link ajaxLink{% if env.getRequestParameter("seasonid") == null %} active{% endif %}"
				data-ajaxtarget="leaguetable_block" data-ajaxblock="leaguetable" data-ajaxquerystr="id={{ leagueId }}">{{ i18n.getMessage("leaguetable_block_title") }}</a>
			</li>
			{% for season in seasons %}
			<li class="nav-item" role="presentation">
				<a href="#season{{ loop.index }}" class="nav-link ajaxLink{% if env.getRequestParameter("seasonid") == season.id %} active{% endif %}"
				data-ajaxtarget="leaguetable_block" data-ajaxblock="leaguetable" data-ajaxquerystr="id={{ leagueId }}&seasonid={{ season.id }}">{{ season.name }}</a>
			</li>
			{% endfor %}
		</ul>
	{% endif %}
	
	<div class="btn-group" style="margin-bottom: 10px;">
		<a class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" href="#showAll">
			{{ i18n.getMessage("leaguetable_button_type") }}
		</a>
		<ul class="dropdown-menu">
			<li><a href="#wholeTable" class="dropdown-item ajaxLink{% if env.getRequestParameter("type") == null %} active{% endif %}"
				data-ajaxtarget="leaguetable_block" data-ajaxblock="leaguetable" data-ajaxquerystr="id={{ leagueId }}&seasonid={{ env.getRequestParameter("seasonid") }}"><i class="bi bi-list-ul"></i> {{ i18n.getMessage("leaguetable_button_type_total") }}</a></li>
			<li><a href="#homeTable" class="dropdown-item ajaxLink{% if env.getRequestParameter("type") == "home" %} active{% endif %}"
				data-ajaxtarget="leaguetable_block" data-ajaxblock="leaguetable" data-ajaxquerystr="id={{ leagueId }}&seasonid={{ env.getRequestParameter("seasonid") }}&type=home"><i class="bi bi-arrow-right"></i> {{ i18n.getMessage("leaguetable_button_type_home") }}</a></li>
			<li><a href="#guestTable" class="dropdown-item ajaxLink{% if env.getRequestParameter("type") == "guest" %} active{% endif %}"
				data-ajaxtarget="leaguetable_block" data-ajaxblock="leaguetable" data-ajaxquerystr="id={{ leagueId }}&seasonid={{ env.getRequestParameter("seasonid") }}&type=guest"><i class="bi bi-arrow-left"></i> {{ i18n.getMessage("leaguetable_button_type_guest") }}</a></li>
		</ul>
	  
		
	</div>
	<a class="btn btn-outline-primary" style="margin-bottom: 10px;" href="{{ env.getInternalUrl("results", "leagueid=" ~ leagueId ~ "&seasonid=" ~ env.getRequestParameter("seasonid")) }}"><i class="bi bi-list"></i> {{ i18n.getMessage("results_navlabel") }}</a>
	
	{% if env.getRequestParameter("seasonid") == null and env.getRequestParameter("type") != null %}
	<p><i class="bi bi-info-circle"></i> <em>{{ i18n.getMessage("leaguetable_timedelay_info") }}</em></p>
	{% endif %}
{% endblock %}

