
{% extends "blocks/table_base.twig" %}

{% block table_header %}
	<div class="btn-group mb-2">
		<a class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" href="#showAll">
			{{ i18n.getMessage("leaguetable_button_type") }}
		</a>
		<ul class="dropdown-menu">
			<li><a href="#wholeTable" class="dropdown-item ajaxLink{% if env.getRequestParameter("type") == null %} active{% endif %}"
				data-ajaxtarget="alltimetable-table_block" data-ajaxblock="alltimetable-table" data-ajaxquerystr="id={{ leagueId }}"><i class="bi bi-list-ul"></i> {{ i18n.getMessage("leaguetable_button_type_total") }}</a></li>
			<li><a href="#homeTable" class="dropdown-item ajaxLink{% if env.getRequestParameter("type") == "home" %} active{% endif %}"
				data-ajaxtarget="alltimetable-table_block" data-ajaxblock="alltimetable-table" data-ajaxquerystr="id={{ leagueId }}&type=home"><i class="bi bi-arrow-right"></i> {{ i18n.getMessage("leaguetable_button_type_home") }}</a></li>
			<li><a href="#guestTable" class="dropdown-item ajaxLink{% if env.getRequestParameter("type") == "guest" %} active{% endif %}"
				data-ajaxtarget="alltimetable-table_block" data-ajaxblock="alltimetable-table" data-ajaxquerystr="id={{ leagueId }}&type=guest"><i class="bi bi-arrow-left"></i> {{ i18n.getMessage("leaguetable_button_type_guest") }}</a></li>
		</ul>
	  
		
	</div>

	<p><i class="bi bi-info-circle"></i> <em>{{ i18n.getMessage("leaguetable_timedelay_info") }}</em></p>
{% endblock %}

