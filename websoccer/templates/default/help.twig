<div class="text-end"><a href="#helpModal" class="btn btn-info" role="button" data-bs-toggle="modal">{{ i18n.getMessage("help_button") }}</a></div>

<div id="helpModal" class="modal fade" tabindex="-1" role="dialog"
	aria-labelledby="helpModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="helpModalLabel">{{ i18n.getMessage("help_dialog_title") }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
	{{ block("help_content") }}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ i18n.getMessage("button_close") }}</button>
      </div>
    </div>
  </div>
</div>
