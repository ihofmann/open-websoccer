
{% import "macros/navitem.twig" as navitemTemplate %}

<nav class="navbar navbar-expand-md fixed-top navbar-light bg-light">
	<div class="container">
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#wsNavbar" aria-controls="wsNavbar" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
		<a class="navbar-brand" href="{{ env.getInternalUrl("home") }}" title="{{ i18n.getNavigationLabel("home") }}">{{ env.getConfig("projectname") }}</a>

		<div class="collapse navbar-collapse" id="wsNavbar">
			<ul class="navbar-nav">
				{% for navItem in navItems %}

				{% if navItem.children|length > 0 %}
				<li class="nav-item dropdown{% if navItem.isActive %} active{% endif %}">
					<button class="nav-link dropdown-toggle" id="label{{ navItem.pageId }}" type="button"
						data-bs-toggle="dropdown" aria-expanded="false">
						{{ navItem.label }}
					</button>
					<ul class="dropdown-menu" aria-labelledby="label{{ navItem.pageId }}">
						<li><a class="dropdown-item" href="{{ env.getInternalUrl(navItem.pageId) }}">{{ navItem.label }}</a></li>
						{% for navChild in navItem.children %}
						<li><a class="dropdown-item{% if navChild.isActive %} active{% endif %}" href="{{ env.getInternalUrl(navChild.pageId) }}">{{ navChild.label }}</a></li>
						{% endfor %}
					</ul>
				</li>
				{% else %}
				{{ navitemTemplate.item(navItem.pageId, navItem.label, navItem.isActive) }}
				{% endif %}

				{% endfor %}
			</ul>
		</div>
	</div>
</nav>
