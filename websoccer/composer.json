{
    "name": "ihofmann/open-websoccer",
    "description": "OpenWebSoccer-Sim - Online Football Manager built with PHP.",
    "type": "project",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "google/recaptcha": "^1.3",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "OpenWebSoccer\\Tests\\": "tests/"
        }
    }
}
